# Copying alone is insufficient: pnpm setup generates local secrets and Garage configuration.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
DEPENDENCY_TIMEOUT_MS=1500
MONGO_USER=orbit
MONGO_PASSWORD=<generated-by-pnpm-setup>
MONGO_REPLICA_KEY=<generated-by-pnpm-setup>
MONGO_URI=mongodb://orbit:<generated-password>@127.0.0.1:27017/orbit?authSource=admin&replicaSet=rs0&directConnection=true
MONGO_TEST_DATABASE=orbit_test
REDIS_PASSWORD=<generated-by-pnpm-setup>
REDIS_URL=redis://:<generated-password>@127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_ACCESS_KEY=<generated-by-pnpm-setup>
S3_SECRET_KEY=<generated-by-pnpm-setup>
S3_BUCKET=orbit-local
# Private disk storage is available only in development/test. Production requires s3.
FILE_STORAGE_DRIVER=disk
# Optional absolute private directory; default is ignored .local/files at the repository root.
# FILE_STORAGE_DIRECTORY=C:/private/orbit-files
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_URL=http://127.0.0.1:8025
APP_ORIGIN=http://127.0.0.1:5173
SMTP_FROM=ORBIT <noreply@orbit.local>
SESSION_IDLE_MINUTES=1440
SESSION_ABSOLUTE_HOURS=168
SMTP_SECURE=false
# SMTP_USER and SMTP_PASSWORD are optional; supply both for an authenticated provider.
# Optional: dev server proxy override for isolated auth verification.
# VITE_API_TARGET=http://127.0.0.1:4001
# Passed to Vite only for an explicitly enabled production-build lab.
# VITE_ENABLE_DESIGN_LAB=true
