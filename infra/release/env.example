# Store completed values in ignored .env.production.local; never COPY into an image.
NODE_ENV=production
APP_ORIGIN=https://orbit.example
MONGO_URI=mongodb://<least-privilege-user>:<password>@<replica-set-hosts>/orbit?replicaSet=<name>&tls=true
REDIS_URL=rediss://:<password>@<host>:6379
DEPENDENCY_TIMEOUT_MS=3000
FILE_STORAGE_DRIVER=s3
S3_ENDPOINT=https://<private-s3-endpoint>
S3_REGION=<region>
S3_BUCKET=<private-bucket>
S3_ACCESS_KEY=<restricted-access-key>
S3_SECRET_KEY=<restricted-secret>
SMTP_HOST=<smtp-host>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=ORBIT <noreply@your-domain.example>
LOG_LEVEL=info
SESSION_IDLE_MINUTES=1440
SESSION_ABSOLUTE_HOURS=168
# Disabled until separately configured and accepted. No model is bundled.
AI_PROVIDER=disabled
AI_QUEUE_NAME=orbit-ai-workflows
BILLING_MODE=disabled
