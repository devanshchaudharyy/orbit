{
  "name": "orbit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "pnpm --filter @orbit/contracts build && node scripts/dev.mjs",
    "build": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api build && pnpm --filter @orbit/web build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @orbit/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @orbit/contracts build && vitest run",
    "test:integration": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api exec tsx ../../scripts/infra-check.ts",
    "test:e2e": "pnpm --filter @orbit/contracts build && playwright test",
    "infra:up": "node scripts/compose.mjs up",
    "infra:down": "node scripts/compose.mjs down",
    "infra:check": "pnpm test:integration",
    "auth:fixture": "pnpm --filter @orbit/contracts build && node scripts/auth-local-fixture.mjs",
    "test:auth:integration": "node scripts/check-auth.mjs",
    "test:auth:transactions": "pnpm --filter @orbit/api exec tsx ../../tests/integration/auth-races.ts",
    "test:auth:e2e": "playwright test -c playwright.auth.config.ts",
    "test:auth:compose": "pnpm --filter @orbit/contracts build && node scripts/auth-compose-check.mjs",
    "test:tenants:integration": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api exec tsx ../../tests/integration/tenants.ts",
    "test:tenants:e2e": "playwright test -c playwright.tenants.config.ts",
    "test:teams:integration": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api exec tsx ../../tests/integration/teams.ts",
    "test:teams:e2e": "playwright test -c playwright.teams.config.ts",
    "test:projects:integration": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api exec tsx ../../tests/integration/projects.ts",
    "test:projects:e2e": "playwright test -c playwright.projects.config.ts",
    "test:views:integration": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api exec tsx ../../tests/integration/views.ts",
    "test:views:e2e": "playwright test -c playwright.views.config.ts",
    "test:planning:integration": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api exec tsx ../../tests/integration/planning.ts",
    "test:planning:e2e": "playwright test -c playwright.planning.config.ts",
    "test:collaboration:integration": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api exec tsx ../../tests/integration/collaboration.ts",
    "test:collaboration:e2e": "playwright test -c playwright.collaboration.config.ts",
    "files:cleanup": "pnpm --filter @orbit/api exec tsx ../../scripts/files-cleanup.ts",
    "test:documents:integration": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api exec tsx ../../tests/integration/documents.ts",
    "test:documents:e2e": "playwright test -c playwright.documents.config.ts",
    "test:analytics:integration": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api exec tsx ../../tests/integration/analytics.ts",
    "test:analytics:e2e": "playwright test -c playwright.analytics.config.ts",
    "worker": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api exec tsx --env-file=../../.env.local src/worker.ts",
    "worker:check": "pnpm --filter @orbit/api exec tsx --env-file=../../.env.local ../../scripts/worker-check.ts",
    "test:ai:integration": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api exec tsx ../../tests/integration/ai.ts",
    "test:ai:worker": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api exec tsx ../../tests/integration/ai-worker.ts",
    "test:ai:live": "pnpm --filter @orbit/contracts build && pnpm --filter @orbit/api exec tsx ../../tests/integration/ai-live.ts",
    "test:ai:e2e": "pnpm --filter @orbit/contracts build && node scripts/check-ai-browser.mjs",
    "auth:fixture:ai": "pnpm --filter @orbit/contracts build && node scripts/auth-local-fixture.mjs start --ai"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
